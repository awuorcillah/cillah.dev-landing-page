      "typeVersion": 1.3,
      "position": [
        320,
        520
      ],
      "credentials": {
        "openAiApi": {
          "id": "J5r9oYQWSirYqPwF",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Instagram DM / Webhook Listener').item.json.body?.entry?.[0]?.changes?.[0]?.value?.from?.id || 'default_session' }}",
        "contextWindowLength": 10
      },
