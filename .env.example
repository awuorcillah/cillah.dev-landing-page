# ==============================================================================
# 7. CONFIRMED BOOKING WEBHOOK (called after Safaricom verifies M-Pesa payment)
# ==============================================================================
BOOKING_CONFIRMED_WEBHOOK_URL=https://n8n.cillah.dev/webhook/your-webhook-id

# ==============================================================================
# 8. OMNICHANNEL MARKETING PUBLISHER WEBHOOK (OPTIONAL - n8n Social Dispatcher)
# ==============================================================================
MARKETING_PUBLISH_WEBHOOK_URL=https://n8n.cillah.dev/webhook/marketing-publish

# ==============================================================================
# 9. NATIVE SOCIAL MEDIA OAUTH 2.0 CREDENTIALS (MULTI-TENANT MARKETING HUB)
# ==============================================================================
# Random 32+ char secret for AES-256-GCM encryption of OAuth tokens in Supabase
MARKETING_TOKEN_ENCRYPTION_KEY=replace_with_a_long_random_32_plus_char_secret

# Meta for Developers (Covers BOTH Facebook Pages + Instagram Business Accounts)
# Redirect URI: https://cillah.dev/api/marketing/oauth/meta/callback
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# LinkedIn Developer Portal
# Redirect URI: https://cillah.dev/api/marketing/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Google Cloud Console (YouTube Data API v3 + YouTube Analytics API)
# Redirect URI: https://cillah.dev/api/marketing/oauth/youtube/callback
YOUTUBE_CLIENT_ID=your_google_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret

# TikTok for Developers (Login Kit + Content Posting API)
# Redirect URI: https://cillah.dev/api/marketing/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
# Set to 'true' once TikTok approves Direct Post audit (defaults to TikTok Inbox/Drafts)
TIKTOK_DIRECT_POST_APPROVED=false

# Secret for /api/marketing/cron/publish-scheduled (call every 5 min from n8n or Vercel Schedules)
CRON_SECRET=replace_with_a_random_secret_at_least_16_chars

# Cloudflare R2 Object Storage (Multi-GB video storage for TikTok, Instagram, Facebook & Website at $0 egress)
R2_ACCOUNT_ID=ab7991100e55949bafd4b94101336486
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=cillah-media
R2_PUBLIC_URL=https://media.cillah.dev

# ==============================================================================
# 10. PAYSTACK PAYMENTS (WEBSITE CARD CHECKOUT + FINANCE DEPARTMENT BILLING)
# ==============================================================================
# Get these in Paystack Dashboard -> Settings -> API Keys & Webhooks
# Webhook URL: https://www.cillah.dev/api/paystack/webhook
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key_here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key_here
