NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXX

# ==============================================================================
# 6. CONSULTATION PRICING (positive whole numbers; defaults: 5000 KES / 40 USD)
# ==============================================================================
NEXT_PUBLIC_CONSULTATION_PRICE_KES=5000
